; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nothung"
run/main_scene="res://scenes/screens/splash.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.055, 0.059, 0.071, 1)
boot_splash/show_image=false
config/icon="res://assets/app_icon/icon.svg"

[autoload]

CardDatabase="*res://autoload/card_database.gd"
Settings="*res://autoload/settings.gd"
SaveManager="*res://autoload/save_manager.gd"
SceneRouter="*res://autoload/scene_router.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gdunit4]

settings/test/test_lookup_folder="tests"
settings/test/test_discovery=true

[gui]

theme/custom="res://ui/theme/main_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.de.translation", "res://localization/strings.es.translation", "res://localization/strings.fr.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.055, 0.059, 0.071, 1)
